<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- ═══ STATUS BAR ══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_idle"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvConnection"
                android:text="Idle"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:fontFamily="monospace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvLastFix"
                android:text=""
                android:textSize="10sp"
                android:textColor="#374151"
                android:fontFamily="monospace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ═══ POSITION CARD (Lat / Lon / Alt separated) ═════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:text="POSITION"
                android:textSize="9sp"
                android:textColor="#3B82F6"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Lat + Lon row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- Latitude -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/coord_cell_bg"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:text="LATITUDE"
                        android:textSize="8sp"
                        android:textColor="#4B5563"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvLatitude"
                        android:text="―"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#E2E8F0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvLatDir"
                        android:text=""
                        android:textSize="9sp"
                        android:textColor="#374151"
                        android:fontFamily="monospace"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Longitude -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/coord_cell_bg"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:text="LONGITUDE"
                        android:textSize="8sp"
                        android:textColor="#4B5563"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvLongitude"
                        android:text="―"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#E2E8F0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvLonDir"
                        android:text=""
                        android:textSize="9sp"
                        android:textColor="#374151"
                        android:fontFamily="monospace"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Altitude full-width row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/coord_cell_bg"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:text="ALTITUDE"
                    android:textSize="8sp"
                    android:textColor="#4B5563"
                    android:letterSpacing="0.1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"/>

                <TextView
                    android:id="@+id/tvAltitude"
                    android:text="―"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="#67E8F9"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:text="m MSL"
                    android:textSize="10sp"
                    android:textColor="#374151"
                    android:fontFamily="monospace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ COMPASS + SAT/SIGNAL ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Compass Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="14dp"
                android:gravity="center_horizontal"
                android:layout_marginEnd="6dp">

                <TextView
                    android:text="HEADING"
                    android:textSize="9sp"
                    android:textColor="#3B82F6"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- Custom rotating compass needle view -->
                <com.ubloxbridge.CompassView
                    android:id="@+id/compassView"
                    android:layout_width="110dp"
                    android:layout_height="110dp"/>

                <TextView
                    android:id="@+id/tvHeading"
                    android:text="―"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="#60A5FA"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvHeadingDir"
                    android:text="―"
                    android:textSize="11sp"
                    android:textColor="#4B5563"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Satellites + Signal stacked -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <!-- Satellites (in view | in use) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="SATELLITES"
                        android:textSize="9sp"
                        android:textColor="#3B82F6"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- In View -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSatsInView"
                                android:text="―"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textColor="#FBBF24"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="in view"
                                android:textSize="9sp"
                                android:textColor="#374151"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#1E2A44"
                            android:layout_marginEnd="10dp"/>

                        <!-- In Use -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSatsUsed"
                                android:text="―"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textColor="#34D399"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="in use"
                                android:textSize="9sp"
                                android:textColor="#374151"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Signal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp">

                    <TextView
                        android:text="SIGNAL"
                        android:textSize="9sp"
                        android:textColor="#3B82F6"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <com.ubloxbridge.SignalBarsView
                        android:id="@+id/signalBarsView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvSignal"
                        android:text=""
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:textColor="#374151"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ MOVEMENT 2x2 GRID ═══════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:text="MOVEMENT"
                android:textSize="9sp"
                android:textColor="#3B82F6"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:text="SPEED"
                        android:textSize="8sp"
                        android:textColor="#4B5563"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:text="―"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#A5F3FC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:text="COURSE"
                        android:textSize="8sp"
                        android:textColor="#4B5563"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvCourse"
                        android:text="―"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#A5F3FC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:text="HDOP"
                        android:textSize="8sp"
                        android:textColor="#4B5563"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvHdop"
                        android:text="―"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#A5F3FC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:text="FIX TYPE"
                        android:textSize="8sp"
                        android:textColor="#4B5563"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvFixType"
                        android:text="―"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#22C55E"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ UPDATE RATE ══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:text="UPDATE RATE"
                android:textSize="9sp"
                android:textColor="#3B82F6"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="@drawable/hz_track_bg"
                android:padding="3dp">

                <Button
                    android:id="@+id/btn1Hz"
                    android:text="1 Hz"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#2563EB"
                    android:textColor="#FFFFFF"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <Button
                    android:id="@+id/btn5Hz"
                    android:text="5 Hz"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#0A1020"
                    android:textColor="#4B5563"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvHzNote"
                android:text="1 Hz · 1 update per second"
                android:textSize="9sp"
                android:textColor="#374151"
                android:fontFamily="monospace"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ═══ CONTROL BUTTONS ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnStart"
                android:text="▶  START"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#16A34A"
                android:textColor="#FFFFFF"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnStop"
                android:text="■  STOP"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#DC2626"
                android:textColor="#FFFFFF"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- ═══ SERIAL LOG ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/log_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:text="SERIAL LOG"
                    android:textSize="9sp"
                    android:textColor="#374151"
                    android:letterSpacing="0.12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvSerialStats"
                    android:text=""
                    android:textSize="9sp"
                    android:textColor="#1F2937"
                    android:fontFamily="monospace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSerial"
                android:text="―"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textColor="#22C55E"
                android:lineSpacingMultiplier="1.6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="6"/>
        </LinearLayout>

        <!-- ═══ FOOTER ═══════════════════════════════════════════════════════════ -->
        <TextView
            android:layout_marginTop="10dp"
            android:text="⚠  Set as Mock Location Provider in Developer Options"
            android:textSize="9sp"
            android:textColor="#D97706"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_marginTop="4dp"
            android:text="Service keeps running while notification is active"
            android:textSize="9sp"
            android:textColor="#1F2937"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
